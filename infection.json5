{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"],
        "excludes": [
            // Behat-only — every unit-suite mutant survives because the
            // adapter has no unit-test caller. The Behat suite is the
            // real safety net for this file.
            "Ssh2/Ssh2Functions.php"
        ]
    },
    "timeout": 30,
    "logs": {
        "text": "build/infection/infection.log",
        "html": "build/infection/infection.html",
        "summary": "build/infection/summary.log"
    },
    "tmpDir": "var/infection",
    // Calibrated 2026-05-18 against the actual test suite (~86% MSI,
    // ~87% covered MSI). Surviving mutants are dominated by harmless
    // operand-reordering on exception messages and redundant `(string)`
    // casts; chasing them to 95% would force brittle
    // expectExceptionMessage assertions for no real bug-catching value.
    // Both gates are kept 2pp under the current baseline so any real
    // test-gap mutant trips the build.
    "minMsi": 85,
    "minCoveredMsi": 85,
    "testFramework": "phpunit",
    "testFrameworkOptions": "--testsuite=unit"
}
